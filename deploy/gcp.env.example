# Copy to .env.gcp and edit. Source only a file you have reviewed.
# Public identifiers only: never put credentials, tokens, or signing keys here.
FW_PROJECT='replace-with-existing-project-id'
FW_REGION='us-central1'
FW_ZONE='us-central1-a'
FW_MACHINE_TYPE='e2-standard-4'
FW_BOOT_DISK_GB='50'
FW_VM='fleet-witness-demo'
FW_NETWORK='fleet-witness'
FW_SUBNET='fleet-witness-us-central1'
FW_SUBNET_RANGE='10.42.0.0/24'
FW_SSH_RULE='fleet-witness-iap-ssh'
FW_HTTPS_RULE='fleet-witness-public-https'
FW_TAG='fleet-witness'
FW_BUCKET='replace-with-globally-unique-build-bucket'
FW_OPERATOR_EMAIL='replace-with-operator@example.org'
# Optional public HTTPS; empty keeps the default private application path.
# This value alone does not configure NixOS; follow DEPLOY_GCP section 7.
FW_DOMAIN=''
FW_STATIC_ADDRESS='fleet-witness-public'
# Evidence stays outside the checkout and images. Choose a protected location.
FW_EVIDENCE="$HOME/fleet-witness-evidence"
# FW_REV, FW_IMAGE, FW_OBJECT, and FW_ARCHIVE are derived in the runbook.
